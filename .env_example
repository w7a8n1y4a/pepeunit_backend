PU_APP_PREFIX=/pepeunit
PU_API_V1_PREFIX=/api/v1

PU_WORKER_COUNT=2

PU_DOMAIN=unit.example.com
PU_SECURE=True

PU_SAVE_REPO_PATH=repo_cache
PU_PROMETHEUS_MULTIPROC_DIR=./prometheus_metrics

PU_SECRET_KEY=<32-bit-key>
PU_ENCRYPT_KEY=<32-bit-key>
PU_STATIC_SALT=<32-bit-key>

PU_SQLALCHEMY_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database_name
PU_CLICKHOUSE_DATABASE_URL=clickhouse+native://user:password@127.0.0.1:9000/default
PU_REDIS_URL=redis://127.0.0.1:6379/0

PU_NOTIFICATION_LOKI_URL=http://127.0.0.1:3100

PU_MQTT_HOST=emqx.example.com
PU_MQTT_SECURE=True
PU_MQTT_PORT=1883
PU_MQTT_API_PORT=18083

PU_MQTT_USERNAME=admin
PU_MQTT_PASSWORD=password

PU_MQTT_REDIS_AUTH_URL=redis://192.168.0.22:6379/0

PU_GRAFANA_ADMIN_USER=admin
PU_GRAFANA_ADMIN_PASSWORD=password

PU_TEST_INTEGRATION_CLEAR_DATA=True
PU_TEST_INTEGRATION_GITHUB_PUBLIC_REPO_URL=https://github.com/w7a8n1y4a/github_unit_pub_test.git
PU_TEST_INTEGRATION_GITLAB_PUBLIC_REPO_URL=https://git.pepemoss.com/pepe/pepeunit/units/gitlab_unit_pub_test.git
PU_TEST_INTEGRATION_UNIVERSAL_REPO_URL=https://git.pepemoss.com/pepe/pepeunit/units/universal_test_unit.git
PU_TEST_INTEGRATION_TELEGRAM_CHAT_ID=
PU_TEST_INTEGRATION_PRIVATE_REPO_ENABLE=False
PU_TEST_INTEGRATION_PRIVATE_REPO_JSON="{\"data\": [{\"type\": \"Private\",\"link\": \"https://git.pepemoss.com/pepe/pepeunit/units/gitlab_unit_priv_test.git\",\"username\": \"test\",\"pat_token\": \"<token>\",\"is_public\": false,\"platform\": \"Gitlab\",\"compile\": true},{\"type\": \"Private\",\"link\": \"https://github.com/w7a8n1y4a/github_unit_priv_test.git\",\"username\": \"test\",\"pat_token\": \"<token>\",\"is_public\": false,\"platform\": \"Github\",\"compile\": true}]}"

PU_TEST_LOAD_MQTT_DURATION=120
PU_TEST_LOAD_MQTT_UNIT_COUNT=100
PU_TEST_LOAD_MQTT_RPS=200
PU_TEST_LOAD_MQTT_VALUE_TYPE=Text
PU_TEST_LOAD_MQTT_DUPLICATE_COUNT=10
PU_TEST_LOAD_MQTT_MESSAGE_SIZE=15
PU_TEST_LOAD_MQTT_POLICY_TYPE=TimeWindow
PU_TEST_LOAD_MQTT_WORKERS=10

LOCUST_HEADLESS=True
LOCUST_USERS=400
LOCUST_RUN_TIME=120
LOCUST_SPAWN_RATE=10
